---
import { getCollection, render } from "astro:content";
import Article from "../../layouts/Article.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Article title={project.data.title} description={project.data.summary} back={{ href: "/", label: "HOME" }}>
  {
    project.data.video ? (
      <video
        slot="meta"
        class="mt-8 aspect-video w-full bg-[#1c1c1c]"
        src={project.data.video}
        poster={project.data.poster}
        controls
        muted
        loop
        playsinline
        preload="metadata"
      />
    ) : (
      <img slot="meta" class="mt-8 aspect-video w-full bg-[#1c1c1c]" src={project.data.poster} alt="" />
    )
  }
  <Content />
</Article>
