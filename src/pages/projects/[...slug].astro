---
import { getCollection, render } from "astro:content";
import Article from "../../layouts/Article.astro";
import Video from "../../components/project/Video.astro";
import "../../styles/project.css";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, video, poster, links, facts } = project.data;
const external = (href) => /^https?:/.test(href);
---

<Article title={title} description={project.data.summary} back={{ href: "/", label: "PROJECTS" }} home>
  <Fragment slot="meta">
    {
      video ? (
        <Video src={video} poster={poster} label={`${title} promo video`} />
      ) : (
        <img class="p-poster" src={poster} alt="" />
      )
    }
    {
      facts.length > 0 && (
        <dl class="p-facts">
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    {
      links.length > 0 && (
        <div class="p-links">
          {links.map((l) => (
            <a href={l.href} target={external(l.href) ? "_blank" : undefined} rel={external(l.href) ? "noopener" : undefined}>
              {l.label}
              <span aria-hidden="true">{external(l.href) ? "↗" : "→"}</span>
            </a>
          ))}
        </div>
      )
    }
  </Fragment>
  <div class="project-body">
    <Content />
  </div>
</Article>
