---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/site.css";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);

// side project tiles, in mosaic order: image in /promos, the name it's read out as, where a click goes
const GITHUB = "https://github.com/JoshuaMarkle";
const tiles = [
  ["pigedex", "Pigedex", `${GITHUB}/pigedex`],
  ["midi2furnace", "midi2furnace", `${GITHUB}/midi2furnace`],
  ["fluid-sim", "Fluid Simulation", `${GITHUB}/fluid-simulation`],
  ["evolution-sim", "Evolution Simulation", `${GITHUB}/evolution-simulation`],
  ["drone-ai", "Drone Stabilization AI", `${GITHUB}/drone-ai`],
  ["sandwich", "Sandwich", `${GITHUB}/sandwich`],
  ["emacs", "Emacs config", `${GITHUB}/emacs`],
  ["nvim", "Neovim config", `${GITHUB}/nvim`],
];
---

<Base title="Joshua Markle">
  <header>
    <h1>
      <a href="/" aria-label="Joshua Markle"><span>JOSHUA</span><span>MARKLE</span></a>
    </h1>
    <Nav />
    <div class="planet">
      <p class="about">happy halloween</p>
      <ascii-art piece="ringed"></ascii-art>
    </div>
  </header>

  <main>
    <p class="hint" aria-hidden="true">j / k to navigate</p>
    {
      projects.map((p) => (
        <a
          class="box"
          href={`/projects/${p.id}/`}
          data-title={p.data.title}
          data-blurb={p.data.summary}
          aria-label={p.data.title}
        >
          {p.data.video ? (
            <video src={p.data.video} poster={p.data.poster} muted loop playsinline preload="none" />
          ) : (
            <img src={p.data.poster} alt="" />
          )}
        </a>
      ))
    }

    <div class="marquee" role="marquee" aria-label="Side projects"></div>

    <section class="mosaic">
      {
        tiles.map(([src, name, href]) => (
          <a class="tile" href={href} target="_blank" rel="noopener" draggable="false">
            <img src={`/promos/${src}.webp`} alt={name} loading="lazy" draggable="false" />
          </a>
        ))
      }
      <button class="press" type="button">PRESS ME</button>
    </section>
  </main>

  <Footer />

  <script>
    import "../scripts/site.js";
  </script>
</Base>
