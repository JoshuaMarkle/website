---
import { getCollection, render } from "astro:content";
import Article from "../../layouts/Article.astro";
import { bookFaces, bookStyle } from "../../scripts/book.js";
import "../../styles/book.css";

// only books with a review (a body) get a page
export async function getStaticPaths() {
  const books = await getCollection(
    "books",
    (b) => (import.meta.env.DEV || !b.data.draft) && Boolean(b.body?.trim()),
  );
  return books.map((book) => ({ params: { slug: book.id }, props: { book } }));
}

const { book } = Astro.props;
const { Content } = await render(book);
const { title, author, rating, finished } = book.data;
const meta = [author, rating && "★".repeat(rating) + "☆".repeat(5 - rating), finished?.toISOString().slice(0, 10)]
  .filter(Boolean)
  .join(" · ");
---

<Article title={title} description={`${title} by ${author}`} back={{ href: "/library/", label: "LIBRARY" }} home>
  <Fragment slot="meta">
    <p class="mt-3 text-xs tracking-[0.12em] text-[#6a6a6a]">{meta.toUpperCase()}</p>
    <div class="turntable mt-10" aria-hidden="true">
      <div class="book3d" style={bookStyle(book.data)} set:html={bookFaces(book.data)} />
    </div>
  </Fragment>
  <Content />
</Article>

<style>
  /* the book slowly turning, cover first */
  .turntable {
    display: flex;
    justify-content: center;
    padding: 24px 0;
    perspective: 1200px;
  }
  .turntable .book3d {
    animation: turn 18s linear infinite;
  }
  @keyframes turn {
    from {
      transform: rotateX(-8deg) rotateY(-70deg);
    }
    to {
      transform: rotateX(-8deg) rotateY(290deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .turntable .book3d {
      animation: none;
      transform: rotateX(-8deg) rotateY(-50deg);
    }
  }
</style>
