<!-- shared by every page: a content-wide row. FOOTER sits where the project names do (pad left of
     the content), the name and email just inside the box edges, the GitHub link where the
     nav docks (pad right of the content) -->
<style is:global>
  /* short pages: the body fills the screen and the footer takes up the slack above it */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
  body > :is(header, main, footer) {
    width: 100%; /* auto side margins would otherwise shrink them to their content */
    box-sizing: border-box;
  }
  footer {
    max-width: var(--content, 640px);
    margin: auto auto 0;
    padding: 0 var(--gutter, 24px) 48px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--fg, #e8e8e8);
  }
  footer .row {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 0 var(--footer-inset, 16px);
  }
  footer .row > * {
    margin: 0;
    font: inherit;
  }
  footer .row a {
    color: inherit;
    text-decoration: none;
  }
  footer .email:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  footer .label {
    position: absolute;
    right: calc(100% + var(--pad, 56px));
  }
  footer .github {
    position: absolute;
    left: calc(100% + var(--pad, 56px));
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  footer .github svg {
    width: 16px;
    height: 16px;
    flex: none;
  }
  /* no room beside the content: everything stacks inside it */
  @media (max-width: 1000px) {
    footer .row {
      flex-direction: column;
      gap: 8px;
    }
    footer .label,
    footer .github {
      position: static;
    }
    footer .label {
      order: -1;
    }
  }
</style>
