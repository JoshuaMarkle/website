---
// a PDF reader in the site's clothes: black page, the blog's breadcrumb, a quiet toolbar, and the PDF drawn
// by pdf.js exactly as it prints (canvas), with a text layer so it can be selected and searched, and its links
// kept clickable. used by /resume/ and /papers/<slug>/
import Base from "../layouts/Base.astro";

// crumbs = [[label, href], ...] after "Joshua Markle"; the last one is the document and has no link
const { src, title, crumbs = [], description, filename = src.split("/").pop() } = Astro.props;
---

<Base title={`${title} · Joshua Markle`} description={description ?? title}>
  <pdf-viewer class="pv" data-src={src}>
    <header class="pv-bar">
      <p class="pv-crumb">
        <a href="/" class="home">Joshua Markle</a>
        {
          crumbs.map(([label, href]) => (
            <>
              <span class="sep">/</span>
              {href ? <a href={href}>{label}</a> : <span class="doc">{label}</span>}
            </>
          ))
        }
      </p>
      <div class="pv-tools">
        <label class="pv-page" title="Page">
          <input type="text" inputmode="numeric" value="1" aria-label="Page number" />
          <span>/ <b data-k="pages">–</b></span>
        </label>
        <span class="pv-div" aria-hidden="true"></span>
        <button type="button" data-z="out" aria-label="Zoom out" title="Zoom out (Ctrl −)">
          <svg viewBox="0 0 16 16"><path d="M3.5 8h9"></path></svg>
        </button>
        <button type="button" class="pv-zoom" data-z="fit" aria-label="Fit to width" title="Fit to width (Ctrl 0)">
          <span data-k="zoom">100%</span>
        </button>
        <button type="button" data-z="in" aria-label="Zoom in" title="Zoom in (Ctrl +)">
          <svg viewBox="0 0 16 16"><path d="M3.5 8h9M8 3.5v9"></path></svg>
        </button>
        <span class="pv-div" aria-hidden="true"></span>
        <a href={src} download={filename} aria-label="Download PDF" title="Download">
          <svg viewBox="0 0 16 16"><path d="M8 2.5v8M4.5 7 8 10.5 11.5 7M3 13.5h10"></path></svg>
        </a>
        <a href={src} target="_blank" rel="noopener" aria-label="Open the raw PDF" title="Open the raw PDF">
          <svg viewBox="0 0 16 16"><path d="M9.5 2.5h4v4M13.5 2.5 7.5 8.5M11.5 9.5v4h-9v-9h4"></path></svg>
        </a>
      </div>
    </header>

    <main class="pv-doc" aria-label={title}>
      <p class="pv-status" data-k="status">Loading {filename}</p>
    </main>
  </pdf-viewer>
</Base>

<style is:global>
  html,
  body {
    margin: 0;
    background: #000;
    color: #e8e8e8;
    color-scheme: dark;
    -webkit-font-smoothing: antialiased;
  }
  pdf-viewer {
    display: block;
    min-height: 100dvh;
    --pv-dim: #6a6a6a;
    --pv-line: #1c1c1c;
    --accent: #55aaff;
  }

  /* the bar: the blog's crumb on the left, tools on the right; it grows a hairline once the page scrolls */
  .pv-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding: 14px 24px;
    background: rgb(0 0 0 / 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .pv.scrolled .pv-bar {
    border-color: var(--pv-line);
  }
  .pv-crumb {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    font-size: 14px;
    letter-spacing: 0.12em;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--pv-dim);
  }
  .pv-crumb a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .pv-crumb a:hover,
  .pv-crumb .home {
    color: #e8e8e8;
  }
  .pv-crumb .sep {
    margin: 0 0.45em;
  }
  .pv-crumb .doc {
    letter-spacing: 0.02em;
    color: #9a9a9a;
  }
  .pv-tools {
    display: flex;
    flex: none;
    align-items: center;
    gap: 2px;
  }
  .pv-tools :is(button, a) {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 32px;
    padding: 0 6px;
    border: 0;
    border-radius: 6px;
    background: none;
    font: 500 12px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #9a9a9a;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }
  .pv-tools :is(button, a):hover {
    background: #141414;
    color: #e8e8e8;
  }
  .pv-tools :is(button, a):focus-visible,
  .pv-page input:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 1px;
  }
  .pv-tools svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pv-zoom {
    min-width: 52px !important;
    font-variant-numeric: tabular-nums;
  }
  .pv-div {
    width: 1px;
    height: 16px;
    margin: 0 8px;
    background: #222;
  }
  .pv-page {
    display: flex;
    align-items: center;
    gap: 6px;
    font: 12px ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--pv-dim);
  }
  .pv-page input {
    width: 3.2ch;
    padding: 5px 4px;
    border: 1px solid #222;
    border-radius: 5px;
    background: #0a0a0a;
    font: inherit;
    text-align: center;
    color: #e8e8e8;
    outline: none;
  }
  .pv-page b {
    font-weight: 400;
    color: #9a9a9a;
  }

  /* the paper */
  .pv-doc {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: 32px 16px 96px;
    overflow-x: auto;
  }
  .pv-status {
    margin: 30vh 0 0;
    font: 12px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.08em;
    color: var(--pv-dim);
  }
  .pv-status::after {
    content: "";
    display: inline-block;
    width: 1ch;
    animation: pv-dots 1.2s steps(4) infinite;
  }
  @keyframes pv-dots {
    0% {
      content: "";
    }
    25% {
      content: ".";
    }
    50% {
      content: "..";
    }
    75% {
      content: "...";
    }
  }
  .pv-sheet {
    position: relative;
    flex: none;
    background: #fff;
    border-radius: 2px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.04),
      0 24px 60px -24px rgb(0 0 0 / 0.9);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  .pv-sheet.drawn {
    opacity: 1;
    transform: none;
  }
  .pv-sheet canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }
  .pv-sheet .pv-n {
    position: absolute;
    top: 0;
    left: calc(100% + 14px);
    font: 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #3a3a3a;
    user-select: none;
  }
  .pv-links a {
    position: absolute;
    z-index: 2;
    border-radius: 2px;
    transition: background 0.15s ease;
  }
  .pv-links a:hover {
    background: rgb(85 170 255 / 0.18);
  }
  .pv-end {
    font: 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
    color: #3a3a3a;
  }
  .pv-end a {
    color: var(--pv-dim);
    text-decoration: none;
  }
  .pv-end a:hover {
    color: #e8e8e8;
  }

  /* pdf.js text layer (from pdfjs-dist/web/pdf_viewer.css): invisible text over the canvas, for selection */
  .pv-sheet .textLayer {
    position: absolute;
    inset: 0;
    overflow: clip;
    line-height: 1;
    text-align: initial;
    text-size-adjust: none;
    forced-color-adjust: none;
    transform-origin: 0 0;
    z-index: 1;
    --min-font-size: 1;
    --text-scale-factor: calc(var(--total-scale-factor) * var(--min-font-size));
    --min-font-size-inv: calc(1 / var(--min-font-size));
  }
  .pv-sheet .textLayer :is(span, br) {
    position: absolute;
    color: transparent;
    white-space: pre;
    cursor: text;
    transform-origin: 0% 0%;
  }
  .pv-sheet .textLayer > :not(.markedContent),
  .pv-sheet .textLayer .markedContent span:not(.markedContent) {
    z-index: 1;
    --font-height: 0;
    font-size: calc(var(--text-scale-factor) * var(--font-height));
    --scale-x: 1;
    --rotate: 0deg;
    transform: rotate(var(--rotate)) scaleX(var(--scale-x)) scale(var(--min-font-size-inv));
  }
  .pv-sheet .textLayer .markedContent {
    display: contents;
  }
  .pv-sheet .textLayer ::selection {
    background: rgb(85 170 255 / 0.35);
    color: transparent;
  }
  .pv-sheet .textLayer br::selection {
    background: transparent;
  }
  .pv-sheet .textLayer .endOfContent {
    display: block;
    position: absolute;
    inset: 100% 0 0;
    z-index: 0;
    cursor: default;
    user-select: none;
  }
  .pv-sheet .textLayer.selecting .endOfContent {
    top: 0;
  }

  @media (max-width: 720px) {
    .pv-bar {
      flex-wrap: wrap;
      padding: 12px 16px;
    }
    .pv-crumb {
      flex: 1 0 100%;
      font-size: 13px;
    }
    .pv-tools {
      flex: 1 0 100%;
      justify-content: space-between;
    }
    .pv-div {
      display: none;
    }
    .pv-doc {
      gap: 16px;
      padding: 16px 8px 64px;
    }
    .pv-sheet .pv-n {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pv-sheet {
      transition: none;
    }
  }
</style>

<script>
  import { getDocument, GlobalWorkerOptions, TextLayer } from "pdfjs-dist";
  import workerUrl from "pdfjs-dist/build/pdf.worker.min.mjs?url";

  GlobalWorkerOptions.workerSrc = workerUrl;

  const CSS_PER_PT = 96 / 72; // pdf.js's 100%: a letter page is 8.5 real inches wide
  const STEPS = [0.5, 0.67, 0.75, 0.9, 1, 1.1, 1.25, 1.5, 1.75, 2, 2.5, 3];

  class PdfViewer extends HTMLElement {
    async connectedCallback() {
      this.doc = this.querySelector(".pv-doc");
      this.k = Object.fromEntries([...this.querySelectorAll("[data-k]")].map((e) => [e.dataset.k, e]));
      this.input = this.querySelector(".pv-page input");
      this.fitted = true;

      try {
        this.pdf = await getDocument({ url: this.dataset.src }).promise;
      } catch (err) {
        this.k.status.textContent = "Couldn't load the PDF. ";
        this.k.status.insertAdjacentHTML("beforeend", `<a href="${this.dataset.src}" style="color:#e8e8e8">Open it directly</a>`);
        this.k.status.style.animation = "none";
        return console.error(err);
      }

      // every page's size up front, so the scroll height is right before anything is drawn
      this.pages = await Promise.all(
        Array.from({ length: this.pdf.numPages }, (_, i) => this.pdf.getPage(i + 1).then((page) => ({ page, n: i + 1 }))),
      );
      this.k.pages.textContent = this.pdf.numPages;
      this.k.status.remove();
      for (const p of this.pages) {
        p.el = document.createElement("div");
        p.el.className = "pv-sheet";
        p.el.dataset.n = p.n;
        p.el.innerHTML = `<span class="pv-n">${p.n}</span>`;
        this.doc.append(p.el);
      }
      const end = document.createElement("p");
      end.className = "pv-end";
      end.innerHTML = `END · <a href="${this.dataset.src}" download>DOWNLOAD PDF</a>`;
      this.doc.append(end);

      this.zoom = this.fitZoom();
      this.layout();

      // draw pages as they come near the screen
      this.io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const p = this.pages[e.target.dataset.n - 1];
            p.near = e.isIntersecting;
            if (p.near) this.draw(p);
          }
        },
        { rootMargin: "100% 0px" },
      );
      for (const p of this.pages) this.io.observe(p.el);

      this.wire();
      this.track();
    }

    wire() {
      this.querySelectorAll("[data-z]").forEach((b) =>
        b.addEventListener("click", () => {
          const z = b.dataset.z;
          if (z === "fit") return this.setZoom(this.fitZoom(), true);
          this.step(z === "in" ? 1 : -1);
        }),
      );
      // page box: type a number, Enter jumps
      this.input.addEventListener("focus", () => this.input.select());
      this.input.addEventListener("keydown", (e) => {
        if (e.key !== "Enter") return;
        const n = Math.max(1, Math.min(this.pages.length, parseInt(this.input.value, 10) || 1));
        this.go(n);
        this.input.blur();
      });
      this.input.addEventListener("blur", () => (this.input.value = this.current || 1));

      // Ctrl +/-/0 and Ctrl+wheel zoom the document, like a real PDF viewer
      addEventListener("keydown", (e) => {
        if (!(e.ctrlKey || e.metaKey)) return;
        if (e.key === "=" || e.key === "+") (e.preventDefault(), this.step(1));
        else if (e.key === "-") (e.preventDefault(), this.step(-1));
        else if (e.key === "0") (e.preventDefault(), this.setZoom(this.fitZoom(), true));
      });
      addEventListener(
        "wheel",
        (e) => {
          if (!e.ctrlKey) return;
          e.preventDefault();
          this.setZoom(this.zoom * Math.exp(-e.deltaY * 0.0025));
        },
        { passive: false },
      );
      // left / right arrows flip pages, unless the zoomed page needs them to scroll sideways
      addEventListener("keydown", (e) => {
        if (e.target.closest?.("input") || e.ctrlKey || e.metaKey || e.altKey) return;
        if (this.doc.scrollWidth > this.doc.clientWidth) return;
        if (e.key === "ArrowRight") (e.preventDefault(), this.go((this.current || 1) + 1));
        if (e.key === "ArrowLeft") (e.preventDefault(), this.go((this.current || 1) - 1));
      });

      let w = innerWidth;
      addEventListener("resize", () => {
        if (innerWidth === w) return;
        w = innerWidth;
        if (this.fitted) this.setZoom(this.fitZoom(), true);
      });
    }

    // the widest page fills the column, up to a comfortable reading width
    fitZoom() {
      const widest = Math.max(...this.pages.map((p) => p.page.getViewport({ scale: 1 }).width));
      const room = Math.min(this.doc.clientWidth - (innerWidth > 720 ? 96 : 16), 880);
      return Math.max(0.3, room / (widest * CSS_PER_PT));
    }
    step(dir) {
      const z = this.zoom;
      const next = dir > 0 ? STEPS.find((s) => s > z + 0.01) : STEPS.findLast((s) => s < z - 0.01);
      this.setZoom(next ?? z);
    }
    setZoom(z, fitted = false) {
      z = Math.max(0.3, Math.min(4, z));
      if (Math.abs(z - this.zoom) < 0.001) return;
      // keep the same spot of the same page under the bar
      const anchor = this.pages[(this.current || 1) - 1];
      const r = anchor.el.getBoundingClientRect();
      const frac = (this.barBottom() - r.top) / r.height;
      this.zoom = z;
      this.fitted = fitted;
      this.layout();
      const r2 = anchor.el.getBoundingClientRect();
      scrollBy(0, r2.top + frac * r2.height - this.barBottom());
      for (const p of this.pages) if (p.near) this.draw(p);
    }
    barBottom() {
      return this.querySelector(".pv-bar").getBoundingClientRect().bottom;
    }

    layout() {
      this.k.zoom.textContent = Math.round(this.zoom * 100) + "%";
      for (const p of this.pages) {
        p.vp = p.page.getViewport({ scale: this.zoom * CSS_PER_PT });
        p.el.style.width = Math.floor(p.vp.width) + "px";
        p.el.style.height = Math.floor(p.vp.height) + "px";
        p.el.style.setProperty("--total-scale-factor", this.zoom * CSS_PER_PT);
        p.el.style.setProperty("--scale-round-x", "1px");
        p.el.style.setProperty("--scale-round-y", "1px");
      }
    }

    async draw(p) {
      const scale = this.zoom;
      if (p.drawnAt === scale) return;
      p.drawnAt = scale;
      p.task?.cancel();
      const vp = p.vp;
      const out = Math.min(devicePixelRatio || 1, 3);
      const canvas = document.createElement("canvas");
      canvas.width = Math.floor(vp.width * out);
      canvas.height = Math.floor(vp.height * out);
      const ctx = canvas.getContext("2d", { alpha: false });
      p.task = p.page.render({
        canvasContext: ctx,
        canvas,
        viewport: vp,
        transform: out !== 1 ? [out, 0, 0, out, 0, 0] : null,
      });
      try {
        await p.task.promise;
      } catch (err) {
        if (err?.name !== "RenderingCancelledException") console.error(err);
        return;
      }
      if (p.drawnAt !== scale) return;
      p.el.querySelector("canvas")?.remove();
      p.el.prepend(canvas);
      p.el.classList.add("drawn");
      this.overlay(p, scale);
    }

    // selectable text and live links on top of the drawn page
    async overlay(p, scale) {
      p.el.querySelector(".textLayer")?.remove();
      p.el.querySelector(".pv-links")?.remove();
      const text = document.createElement("div");
      text.className = "textLayer";
      const links = document.createElement("div");
      links.className = "pv-links";
      p.el.append(text, links);

      const layer = new TextLayer({ textContentSource: p.page.streamTextContent(), container: text, viewport: p.vp });
      await layer.render().catch(() => {});
      if (p.drawnAt !== scale) return;
      // selection: let a drag past the end of a line keep selecting instead of grabbing the whole page
      text.addEventListener("mousedown", () => text.classList.add("selecting"));
      addEventListener("mouseup", () => text.classList.remove("selecting"));

      for (const a of await p.page.getAnnotations({ intent: "display" })) {
        if (a.subtype !== "Link" || !(a.url || a.dest)) continue;
        const [x1, y1] = p.vp.convertToViewportPoint(a.rect[0], a.rect[1]);
        const [x2, y2] = p.vp.convertToViewportPoint(a.rect[2], a.rect[3]);
        const el = document.createElement("a");
        Object.assign(el.style, {
          left: Math.min(x1, x2) + "px",
          top: Math.min(y1, y2) + "px",
          width: Math.abs(x2 - x1) + "px",
          height: Math.abs(y2 - y1) + "px",
        });
        if (a.url) {
          el.href = a.url;
          el.title = a.url.replace(/^mailto:/, "");
          if (!a.url.startsWith("mailto:")) (el.target = "_blank"), (el.rel = "noopener");
        } else {
          el.href = "#";
          el.addEventListener("click", async (e) => {
            e.preventDefault();
            const dest = typeof a.dest === "string" ? await this.pdf.getDestination(a.dest) : a.dest;
            if (!dest) return;
            const n = (typeof dest[0] === "number" ? dest[0] : await this.pdf.getPageIndex(dest[0])) + 1;
            const target = this.pages[n - 1];
            // XYZ destinations carry a y in PDF units; land on it
            const y = dest[1]?.name === "XYZ" && dest[3] != null ? target.vp.convertToViewportPoint(0, dest[3])[1] : 0;
            scrollTo({ top: scrollY + target.el.getBoundingClientRect().top + y - this.barBottom() - 12, behavior: "smooth" });
          });
        }
        links.append(el);
      }
    }

    go(n) {
      n = Math.max(1, Math.min(this.pages.length, n));
      const el = this.pages[n - 1].el;
      scrollTo({ top: scrollY + el.getBoundingClientRect().top - this.barBottom() - 16, behavior: "smooth" });
    }

    // which page is under the reading line, and the bar's hairline
    track() {
      const update = () => {
        this.classList.toggle("scrolled", scrollY > 4);
        const line = innerHeight * 0.4;
        let cur = 1;
        for (const p of this.pages) if (p.el.getBoundingClientRect().top <= line) cur = p.n;
        if (cur !== this.current) {
          this.current = cur;
          if (document.activeElement !== this.input) this.input.value = cur;
        }
      };
      addEventListener("scroll", update, { passive: true });
      update();
    }
  }
  customElements.define("pdf-viewer", PdfViewer);
</script>
