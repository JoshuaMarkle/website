---
// AlgoType's typing test, ported line for line from the site's engine (algotype/src/components/typing:
// hooks/useTypingState.js and TypingRenderer.jsx). The code is a short binary search, tokenized by AlgoType's
// own tokenizer (backend/scripts/tokenizer.js) into src/data/algotype-binary-search.json.
// The rules match: indentation and blank lines are skipped, one space press finishes a run of spaces,
// Enter ends a line, a wrong key paints the characters it lands on red (and spills past the end of the
// word as extra red characters) until you backspace it out. A bot types until you click in.
---

<typing-demo class="p-panel td">
  <div class="td-top">
    <span class="td-crumb">Algorithms <i>/</i> Python <i>/</i> <b>Binary Search</b></span>
    <span class="td-stats">
      <span><b data-k="wpm">0</b> wpm</span>
      <span><b data-k="acc">100</b>% acc</span>
      <span><b data-k="time">0</b>s</span>
    </span>
  </div>
  <div class="td-view">
    <pre class="td-code" aria-label="Typing test: click and type the code"></pre>
    <button type="button" class="td-focus" hidden>Click to keep typing</button>
  </div>
  <textarea class="td-input" autocapitalize="off" autocomplete="off" autocorrect="off" spellcheck="false" aria-label="Typing input"></textarea>
  <div class="td-foot">
    <span class="td-hint"><span class="td-live"></span>Watching a replay. <b>Click the code to take over.</b></span>
    <button type="button" class="td-restart">Restart <kbd>tab</kbd></button>
  </div>
</typing-demo>

<style is:global>
  .td {
    /* typed code takes these; untyped code stays gray. Picked to sit on the site's black, around its blue */
    --kw: #7cc4ff;
    --fn: #c3b5ff;
    --bi: #8fd6c7;
    --num: #f2c47c;
    --str: #a8d89a;
    --op: #9fd0ff;
    --punc: #a8a8a8;
    --plain: #e8e8e8;
    --todo: #707070; /* code you haven't reached */
    --off: #454545; /* comments, never typed */
    --bad: #ff6b6b;
    display: block;
    position: relative;
    padding: 0 !important;
    overflow: hidden;
  }
  .td-top,
  .td-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
    padding: 12px 18px;
    font-size: 13px;
    color: var(--dim);
  }
  .td-top {
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
  }
  .td-foot {
    border-top: 1px solid var(--line);
  }
  .td-crumb i {
    margin: 0 0.35em;
    font-style: normal;
    color: #3a3a3a;
  }
  .td-crumb b {
    font-weight: 500;
    color: #e8e8e8;
  }
  .td-stats {
    display: flex;
    gap: 16px;
    font: 12px var(--mono);
  }
  .td-stats b {
    display: inline-block;
    min-width: 2ch;
    margin-right: 0.3em;
    text-align: right;
    font-size: 15px;
    font-weight: 500;
    color: #e8e8e8;
    font-variant-numeric: tabular-nums;
  }

  .td-view {
    position: relative;
  }
  .prose-post .td-code {
    position: relative;
    margin: 0;
    padding: 18px 18px 18px 0;
    overflow: hidden auto; /* long lines scroll sideways on phones; up/down follows the cursor */
    border: 0;
    border-radius: 0;
    background: transparent !important;
    font: 14px/24px var(--mono);
    white-space: pre;
    color: var(--todo);
    cursor: text;
    user-select: none;
  }
  .td-code .ln {
    display: flex;
    min-height: 24px;
  }
  .td-code .no {
    flex: none;
    width: 3ch;
    margin-right: 2.5ch;
    text-align: right;
    color: #333;
    transition: color 0.15s ease;
  }
  .td-code .ln.here .no {
    color: var(--soft);
  }
  .td-code .tk {
    color: var(--todo);
  }
  .td-code .t-keyword {
    color: var(--kw);
  }
  .td-code .t-function {
    color: var(--fn);
  }
  .td-code .t-builtin {
    color: var(--bi);
  }
  .td-code :is(.t-number, .t-boolean) {
    color: var(--num);
  }
  .td-code .t-string {
    color: var(--str);
  }
  .td-code .t-operator {
    color: var(--op);
  }
  .td-code .t-punctuation {
    color: var(--punc);
  }
  .td-code .t-plain {
    color: var(--plain);
  }
  .td-code :is(.t-comment, .t-off) {
    color: var(--off);
  }
  .td-code .t-wrong {
    color: var(--bad);
    text-decoration: underline;
    text-decoration-color: rgb(255 107 107 / 0.5);
    text-underline-offset: 4px;
  }
  .td-code .t-nl {
    color: #4a4a4a;
  }
  /* AlgoType's block cursor, here in the site's blue; it blinks while you're not typing */
  .td-code .cur {
    border-radius: 2px;
    background: rgb(85 170 255 / 0.3);
    color: #fff;
    box-shadow: inset 0 -2px 0 var(--tone);
  }
  .td:not(.typing) .td-code .cur {
    animation: td-blink 1.1s steps(1) infinite;
  }
  @keyframes td-blink {
    50% {
      background: transparent;
      box-shadow: none;
    }
  }

  .td-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    opacity: 0;
    resize: none;
    pointer-events: none;
  }
  .td-focus {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    border: 0;
    background: rgb(10 10 10 / 0.6);
    backdrop-filter: blur(2px);
    font: inherit;
    font-size: 14px;
    color: #e8e8e8;
    cursor: pointer;
  }
  .td-focus[hidden] {
    display: none;
  }
  .td-hint {
    min-width: 0;
  }
  .td-hint b {
    font-weight: 500;
    color: #e8e8e8;
  }
  .td-live {
    display: inline-block;
    margin: 0 9px 1px 0;
    vertical-align: middle;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tone);
    animation: td-pulse 1.6s ease infinite;
  }
  @keyframes td-pulse {
    50% {
      opacity: 0.25;
    }
  }
  .td-restart {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 9px;
    border: 1px solid #262626;
    border-radius: 5px;
    background: none;
    font: inherit;
    font-size: 12px;
    color: var(--soft);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .td-restart:hover {
    border-color: #3a3a3a;
    color: #e8e8e8;
  }
  .td-restart kbd {
    font: 11px var(--mono);
    color: var(--dim);
  }

  /* finished: a results card over the code, like AlgoType's results screen */
  .td-done {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 28px;
    padding: 24px 28px;
    background: rgb(10 10 10 / 0.9);
    backdrop-filter: blur(4px);
    animation: td-in 0.35s ease both;
  }
  .td-done .big {
    font-size: 72px;
    font-weight: 650;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: #e8e8e8;
    font-variant-numeric: tabular-nums;
  }
  .td-done .big small {
    display: block;
    margin-top: 10px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--dim);
  }
  .td-done dl {
    display: flex;
    gap: 22px;
    margin: 0 0 14px;
  }
  .td-done dt {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--dim);
  }
  .td-done dd {
    margin: 4px 0 0;
    font: 500 18px var(--mono);
    color: #e8e8e8;
  }
  .td-done svg {
    display: block;
    width: 100%;
    height: 90px;
    overflow: visible;
  }
  .td-done svg .area {
    fill: url(#td-fade);
  }
  .td-done svg .line {
    fill: none;
    stroke: var(--tone);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .td-done svg .grid {
    stroke: #1c1c1c;
    vector-effect: non-scaling-stroke;
  }
  .td-done .again {
    margin-top: 10px;
    font-size: 12px;
    color: var(--dim);
  }
  @keyframes td-in {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
  }

  @container panel (max-width: 560px) {
    .prose-post .td-code {
      padding-right: 12px;
      font-size: clamp(10.5px, 2.4cqi, 12px);
      line-height: 22px;
    }
    .td-code .ln {
      min-height: 22px;
    }
    .td-code .no {
      width: 2ch;
      margin-right: 1.5ch;
    }
    .td-hint {
      display: none;
    }
    .td-foot {
      justify-content: flex-end;
    }
    .td-done {
      grid-template-columns: 1fr;
      gap: 14px;
      text-align: left;
    }
    .td-done .big {
      font-size: 52px;
    }
  }
</style>

<script>
  import challenge from "../../data/algotype-binary-search.json";

  const lines = challenge.tokens;
  const esc = (s) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

  // a line has something to type if it holds a token that isn't skipped, a space or a newline
  const typable = lines.map((line) =>
    line.some((t) => !t.skip && t.type !== "space" && t.type !== "newline" && t.content?.length > 0),
  );

  class TypingDemo extends HTMLElement {
    connectedCallback() {
      this.code = this.querySelector(".td-code");
      this.input = this.querySelector(".td-input");
      this.cover = this.querySelector(".td-focus");
      this.k = Object.fromEntries([...this.querySelectorAll("[data-k]")].map((b) => [b.dataset.k, b]));
      this.lineEls = lines.map((_, i) => {
        const el = document.createElement("div");
        el.className = "ln";
        this.code.append(el);
        return el;
      });

      const take = (e) => {
        e?.preventDefault();
        this.input.focus({ preventScroll: true });
        this.cover.hidden = true;
        if (!this.mine) {
          this.mine = true;
          this.querySelector(".td-hint").innerHTML = "Your turn. <b>Tab</b> restarts, <b>Esc</b> lets go.";
          this.reset();
        }
      };
      this.code.addEventListener("mousedown", take);
      this.cover.addEventListener("click", take);
      this.input.addEventListener("keydown", (e) => this.onKey(e));
      // phones don't send real key events; take whatever the keyboard inserted
      this.input.addEventListener("input", () => {
        for (const ch of this.input.value) this.key(ch === "\n" ? "Enter" : ch);
        this.input.value = "";
      });
      this.input.addEventListener("focus", () => (this.cover.hidden = true));
      this.input.addEventListener("blur", () => {
        this.classList.remove("typing");
        if (this.mine && this.started && !this.done) this.cover.hidden = false;
      });
      this.querySelector(".td-restart").addEventListener("click", () => {
        this.reset();
        if (this.mine) this.input.focus({ preventScroll: true });
      });

      this.reset();
      // the bot only types while the demo is on screen
      new IntersectionObserver(([e]) => {
        this.visible = e.isIntersecting;
        if (this.visible && !this.mine) this.botStep();
      }).observe(this);
    }

    // ---- engine: useTypingState.js ----

    reset() {
      clearTimeout(this.timer);
      clearInterval(this.sampler);
      clearInterval(this.ticker);
      this.querySelector(".td-done")?.remove();
      this.stats = { correct: 0, incorrect: 0, backspace: 0 };
      this.samples = [];
      this.started = 0;
      this.ended = 0;
      this.done = false;
      this.li = 0;
      this.ti = 0;
      this.typed = 0;
      this.wrong = "";
      this.cover.hidden = true;
      this.skipUntilTypable(0, 0);
      for (let i = 0; i < lines.length; i++) this.renderLine(i);
      this.code.scrollTop = 0;
      this.show();
      if (!this.mine && this.visible) this.botStep();
    }

    get tok() {
      return lines[this.li]?.[this.ti] ?? { content: "", skip: true };
    }

    // is there a non-newline token to type after this position?
    hasTypableAfter(line, token) {
      for (let li = line; li < lines.length; li++) {
        if (!typable[li]) continue;
        for (let ti = li === line ? token + 1 : 0; ti < lines[li].length; ti++) {
          const t = lines[li][ti];
          if (t.skip || t.type === "newline") continue;
          if (t.type === "space" || t.content?.length > 0) return true;
        }
      }
      return false;
    }

    skipUntilTypable(li, ti) {
      this.typed = 0;
      this.wrong = "";
      while (li < lines.length) {
        while (typable[li] && ti < lines[li].length) {
          const t = lines[li][ti];
          if (t.skip) {
            ti++;
            continue;
          }
          // a trailing newline has nothing after it, so the test ends on the last character
          if (t.type === "newline" && !this.hasTypableAfter(li, ti)) break;
          if (t.type === "newline" || t.type === "space" || t.content?.length > 0) {
            this.li = li;
            this.ti = ti;
            return;
          }
          ti++;
        }
        li++;
        ti = 0;
      }
      this.finish();
    }
    forward() {
      this.skipUntilTypable(this.li, this.ti + 1);
    }

    // characters left before the end of the current word
    room() {
      const line = lines[this.li];
      const end = this.ti + (this.tok.wlength ?? 1) - 1;
      let room = 0;
      for (let ti = this.ti; ti <= end; ti++) {
        const off = ti === this.ti ? this.typed + this.wrong.length : 0;
        room += (line[ti].content?.length ?? 0) - off;
      }
      return room;
    }

    onKey(e) {
      if (e.key === "Tab") {
        e.preventDefault();
        return this.reset();
      }
      if (e.key === "Escape") return this.input.blur();
      // leave browser shortcuts alone; Ctrl+Alt is AltGr on some layouts
      if (e.metaKey || (e.ctrlKey && !e.altKey)) return;
      if (e.key.length === 1 || e.key === "Backspace" || e.key === "Enter") {
        e.preventDefault();
        this.classList.add("typing");
        clearTimeout(this.idle);
        this.idle = setTimeout(() => this.classList.remove("typing"), 600);
        this.key(e.key);
      }
    }

    key(key) {
      if (this.done) return;
      if (!this.started) {
        this.started = performance.now();
        this.sampler = setInterval(() => this.samples.push(this.calc().wpm), 1000);
        this.tick();
      }
      const tok = this.tok;
      const expected = tok.content;
      const line = this.li;

      if (key === "Backspace") {
        if (this.wrong) this.wrong = this.wrong.slice(0, -1);
        else if (this.typed > 0) this.typed--;
        this.stats.backspace++;
      } else if (key === "Enter" && tok.type === "newline" && !this.wrong) {
        this.stats.correct++;
        this.forward();
      } else if (key === " " && tok.type === "space" && !this.wrong) {
        this.stats.correct++;
        this.forward();
      } else if (key.length !== 1) {
        return; // a stray Enter
      } else if (this.room() > 0 && key === expected[this.typed] && !this.wrong) {
        this.stats.correct++;
        if (this.typed + 1 >= expected.length) this.forward();
        else this.typed++;
      } else if (this.wrong.length < 10) {
        this.wrong += key;
        this.stats.incorrect++;
      }

      if (this.done) return;
      this.renderLine(line);
      if (this.li !== line) this.renderLine(this.li);
      this.follow();
    }

    calc() {
      const end = this.ended || performance.now();
      const s = this.started ? (end - this.started) / 1000 : 0;
      const { correct, incorrect } = this.stats;
      return {
        wpm: s > 0 ? Math.round(correct / 5 / (s / 60)) : 0,
        acc: correct + incorrect > 0 ? Math.floor((100 * correct) / (correct + incorrect)) : 100,
        time: Math.round(s),
      };
    }
    show() {
      const { wpm, acc, time } = this.calc();
      this.k.wpm.textContent = wpm;
      this.k.acc.textContent = acc;
      this.k.time.textContent = time;
    }
    // the readout steps once a second, so the wpm doesn't jitter with every key
    tick() {
      clearInterval(this.ticker);
      this.ticker = setInterval(() => {
        if (this.done || !this.started) return clearInterval(this.ticker);
        this.show();
      }, 1000);
    }

    // ---- renderer: TypingRenderer.jsx ----

    renderLine(li) {
      const line = lines[li];
      const here = li === this.li && !this.done;
      const lastWord = this.ti + (this.tok.wlength ?? 1) - 1;
      let wordOffset = 0;
      let wrongLeft = here ? this.wrong.length : 0;
      let html = "";

      line.forEach((t, ti) => {
        const past = li < this.li || (li === this.li && ti < this.ti) || this.done;
        const future = !(here && ti >= this.ti && ti <= lastWord);
        const type = `t-${t.type ?? "plain"}`;

        // newlines only show where the cursor is
        if (t.type === "newline" && (past || future) && !(here && ti === this.ti)) return;
        if (past) return (html += `<span class="${type}">${esc(t.content)}</span>`);
        if (future) return (html += `<span class="tk${t.type === "comment" ? " t-off" : ""}">${esc(t.content)}</span>`);

        // the word under the cursor, character by character
        const chars = t.type === "newline" ? ["↵"] : [...t.content];
        chars.forEach((ch, ci) => {
          const pos = wordOffset + ci;
          let cls;
          if (ti === this.ti && ci < this.typed) cls = type;
          else if (wrongLeft > 0 && pos >= this.typed) (cls = "t-wrong"), wrongLeft--;
          else cls = t.type === "newline" ? "t-nl" : "tk";
          if (pos === this.typed + this.wrong.length) cls += " cur";
          html += `<span class="${cls}">${esc(ch)}</span>`;
        });
        wordOffset += chars.length;

        // wrong keys past the end of the word spill over after it
        if (ti === lastWord && wrongLeft > 0) {
          html += `<span class="t-wrong">${esc(this.wrong.slice(-wrongLeft))}</span><span class="cur"> </span>`;
          wrongLeft = 0;
        } else if (ti === lastWord && this.wrong && this.typed + this.wrong.length === wordOffset) {
          // the wrong keys exactly cover the word: keep the cursor visible just past it
          html += `<span class="cur"> </span>`;
        }
      });

      const el = this.lineEls[li];
      el.className = here ? "ln here" : "ln";
      el.innerHTML = `<span class="no">${li + 1}</span><span>${html}</span>`;
    }

    // useAutoScroll.js, inside the panel: ease the cursor's line toward the middle
    follow() {
      const el = this.lineEls[this.li];
      const target = Math.max(0, el.offsetTop - this.code.clientHeight / 2 + el.offsetHeight / 2);
      if (this.scrolling) return (this.scrollTarget = target);
      this.scrollTarget = target;
      this.scrolling = true;
      const stepScroll = () => {
        const diff = this.scrollTarget - this.code.scrollTop;
        if (Math.abs(diff) > 1) {
          this.code.scrollTop += diff * 0.15;
          requestAnimationFrame(stepScroll);
        } else this.scrolling = false;
      };
      requestAnimationFrame(stepScroll);
    }

    finish() {
      if (this.done) return;
      this.done = true;
      this.ended = performance.now();
      clearInterval(this.sampler);
      if (!this.lineEls) return;
      for (let i = 0; i < lines.length; i++) this.renderLine(i);
      this.show();
      const { wpm, acc, time } = this.calc();
      this.samples.push(wpm);
      const card = document.createElement("div");
      card.className = "td-done";
      card.innerHTML = `<div class="big">${wpm}<small>WPM</small></div>
        <div>
          <dl>
            <div><dt>ACCURACY</dt><dd>${acc}%</dd></div>
            <div><dt>TIME</dt><dd>${time}s</dd></div>
            <div><dt>KEYS</dt><dd>${this.stats.correct}</dd></div>
          </dl>
          ${this.chart()}
          <div class="again">${this.mine ? "Tab or Restart to go again" : "Replaying in a moment. Click the code to try it yourself."}</div>
        </div>`;
      this.querySelector(".td-view").append(card);
      card.addEventListener("mousedown", (e) => {
        e.preventDefault();
        if (!this.mine) {
          this.mine = true;
          this.querySelector(".td-hint").innerHTML = "Your turn. <b>Tab</b> restarts, <b>Esc</b> lets go.";
        }
        this.reset();
        this.input.focus({ preventScroll: true });
      });
      if (!this.mine) this.timer = setTimeout(() => this.reset(), 4500);
    }

    // wpm over time, one point a second
    chart() {
      const s = this.samples.length > 1 ? this.samples : [0, ...this.samples];
      const max = Math.max(10, ...s) * 1.15;
      const pts = s.map((v, i) => `${((i / (s.length - 1)) * 100).toFixed(2)},${(40 - (v / max) * 40).toFixed(2)}`);
      return `<svg viewBox="0 0 100 40" preserveAspectRatio="none" aria-label="Words per minute over time">
        <defs><linearGradient id="td-fade" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#55aaff" stop-opacity=".22"/><stop offset="1" stop-color="#55aaff" stop-opacity="0"/></linearGradient></defs>
        <line class="grid" x1="0" x2="100" y1="40" y2="40"/><line class="grid" x1="0" x2="100" y1="20" y2="20" stroke-dasharray="2 2"/>
        <path class="area" d="M0,40 L${pts.join(" L")} L100,40 Z"/><path class="line" d="M${pts.join(" L")}"/></svg>`;
    }

    // ---- the replay bot: a human pace (85-155 ms a key), a beat after words, now and then a typo burst ----
    botStep() {
      clearTimeout(this.timer);
      if (this.mine || this.done || !this.visible) return;
      const t = this.tok;
      let delay = 85 + Math.random() * 70;
      if (this.typo > 0) {
        this.typo--;
        this.key("abcdefghijklmnopqrstuvwxyz"[(Math.random() * 26) | 0]);
        if (!this.typo) delay = 380;
      } else if (this.wrong) {
        this.key("Backspace");
        delay = 140 + Math.random() * 50;
      } else if (t.type !== "space" && t.type !== "newline" && Math.random() < 0.014) {
        this.typo = 1 + ((Math.random() * 3) | 0);
        delay = 10;
      } else {
        const k = t.type === "newline" ? "Enter" : t.type === "space" ? " " : t.content[this.typed];
        this.key(k);
        if (k === " " || k === "Enter") delay += 70 + Math.random() * 60;
      }
      this.timer = setTimeout(() => this.botStep(), delay);
    }
  }
  customElements.define("typing-demo", TypingDemo);
</script>
