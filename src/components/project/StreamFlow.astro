---
// the request path of the chatbot, animated: the prompt goes out to the edge route and Gemini,
// chunks come back one by one and the reply bubble grows as they land
const steps = [
  ["Browser", "page.jsx", "POST { messages }"],
  ["Edge route", "api/chat/route.js", "prompt + system text"],
  ["Gemini", "1.5 Flash", "generateContentStream"],
];
---

<div class="p-panel sf" aria-label="Diagram: a message goes from the browser to an edge function to Gemini, and the answer streams back in chunks">
  <div class="sf-lane">
    {
      steps.map(([name, file, note], i) => (
        <div class="sf-node">
          <b>{name}</b>
          <code>{file}</code>
          <span>{note}</span>
          {i === 0 && (
            <div class="sf-chat">
              <div class="sf-q" />
              <div class="sf-a">
                <i style="--w:92%" />
                <i style="--w:78%" />
                <i style="--w:86%" />
                <i style="--w:54%" />
              </div>
            </div>
          )}
        </div>
      ))
    }
    <div class="sf-wire w1"><i class="sf-req"></i>{[0, 1, 2, 3, 4, 5].map((k) => <i class="sf-chunk" style={`--k:${k}`} />)}</div>
    <div class="sf-wire w2"><i class="sf-req"></i>{[0, 1, 2, 3, 4, 5].map((k) => <i class="sf-chunk" style={`--k:${k}`} />)}</div>
  </div>
  <p class="cap">
    The route doesn't wait for the whole answer. It pipes each chunk from Gemini into a <code>ReadableStream</code>, and the page reads it with a
    stream reader and re-renders the reply as Markdown after every chunk.
  </p>
</div>

<style>
  .sf {
    --cycle: 6s;
  }
  .sf-lane {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 12%;
    align-items: start;
    padding: 6px 0 0;
  }
  .sf-node {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid #262626;
    border-radius: 8px;
    background: #050505;
  }
  .sf-node b {
    font-size: 15px;
    font-weight: 600;
    color: #e8e8e8;
  }
  .sf-node code {
    padding: 0 !important;
    background: none !important;
    font-size: 12px !important;
    color: var(--tone) !important;
  }
  .sf-node span {
    font: 11px var(--mono);
    color: #5a5a5a;
  }
  .sf-chat {
    display: grid;
    gap: 8px;
    margin-top: 10px;
    padding-top: 12px;
    border-top: 1px solid #1a1a1a;
  }
  .sf-q {
    justify-self: end;
    width: 58%;
    height: 22px;
    border-radius: 6px;
    background: #232a3a;
  }
  .sf-a {
    display: grid;
    gap: 6px;
    padding: 2px 0;
  }
  .sf-a i {
    display: block;
    height: 7px;
    border-radius: 4px;
    background: #2e2e2e;
    width: var(--w);
    transform-origin: left;
    animation: sf-type var(--cycle) linear infinite;
  }
  .sf-a i:nth-child(2) {
    animation-name: sf-type2;
  }
  .sf-a i:nth-child(3) {
    animation-name: sf-type3;
  }
  .sf-a i:nth-child(4) {
    animation-name: sf-type4;
  }
  /* each line of the reply fills while its chunks arrive */
  @keyframes sf-type {
    0%,
    38% {
      transform: scaleX(0);
    }
    50%,
    96% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(0);
    }
  }
  @keyframes sf-type2 {
    0%,
    50% {
      transform: scaleX(0);
    }
    62%,
    96% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(0);
    }
  }
  @keyframes sf-type3 {
    0%,
    62% {
      transform: scaleX(0);
    }
    74%,
    96% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(0);
    }
  }
  @keyframes sf-type4 {
    0%,
    74% {
      transform: scaleX(0);
    }
    82%,
    96% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(0);
    }
  }
  /* wires between the nodes */
  .sf-wire {
    position: absolute;
    top: 34px;
    height: 2px;
    background: #1c1c1c;
  }
  .w1 {
    left: calc(1.3 / 3.3 * 76%);
    width: 12%;
  }
  .w2 {
    left: calc((1.3 + 1) / 3.3 * 76% + 12%);
    width: 12%;
  }
  .sf-wire i {
    position: absolute;
    top: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .sf-req {
    background: #8ab4ff;
    animation: sf-out var(--cycle) linear infinite;
  }
  .w2 .sf-req {
    animation-name: sf-out2;
  }
  .sf-chunk {
    border-radius: 2px !important;
    background: var(--tone);
    opacity: 0;
    animation: sf-back var(--cycle) linear infinite;
    animation-delay: calc(var(--k) * 0.42s);
  }
  @keyframes sf-out {
    0% {
      left: 0;
      opacity: 1;
    }
    12% {
      left: 100%;
      opacity: 1;
    }
    13%,
    100% {
      opacity: 0;
    }
  }
  @keyframes sf-out2 {
    0%,
    12% {
      left: 0;
      opacity: 0;
    }
    13% {
      opacity: 1;
    }
    25% {
      left: 100%;
      opacity: 1;
    }
    26%,
    100% {
      opacity: 0;
    }
  }
  /* chunks start coming back once the request has reached Gemini */
  @keyframes sf-back {
    0%,
    28% {
      left: 100%;
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    42% {
      left: 0;
      opacity: 1;
    }
    43%,
    100% {
      left: 0;
      opacity: 0;
    }
  }
  @container panel (max-width: 540px) {
    .sf-lane {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .sf-wire {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sf * {
      animation: none !important;
    }
  }
</style>
