---
// JAGUAR's race simulator output for the 98 lb baseline canoe: the planned path around the buoys,
// colored by simulated speed, with the boat replayed at 10x
import data from "../../data/jaguar.json";
const evs = data.race.events;
const short = { slalom_200: "200 m slalom", sprint_400: "400 m sprint", endurance_600: "600 m endurance" };
---

<race-course class="p-panel rc">
  <div class="rc-head">
    <div class="p-seg">
      {evs.map((e, i) => <button type="button" aria-pressed={i === 0 ? "true" : "false"} data-i={i}>{short[e.course]}</button>)}
    </div>
    <div class="rc-read">
      <span><b data-k="t">0.0</b> s</span>
      <span><b data-k="v">0.00</b> m/s</span>
    </div>
  </div>
  <svg class="rc-svg" aria-label="Race course with the simulated path"></svg>
  <div class="rc-foot">
    <span data-k="info"></span>
    <span class="rc-key"><i></i> slow <i class="f"></i> fast · 10× speed</span>
  </div>
</race-course>

<style is:global>
  race-course {
    display: block;
  }
  .rc-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .rc-read {
    display: flex;
    gap: 18px;
    font: 12px var(--mono);
    color: #6a6a6a;
  }
  .rc-read b {
    font-size: 20px;
    font-weight: 500;
    color: #e8e8e8;
    font-variant-numeric: tabular-nums;
  }
  .rc-svg {
    display: block;
    width: 100%;
    height: 340px;
    margin-top: 16px;
    border-radius: 6px;
    background:
      radial-gradient(circle at 50% 50%, rgb(85 170 255 / 0.05), transparent 70%),
      repeating-linear-gradient(0deg, transparent 0 39px, #121212 39px 40px),
      repeating-linear-gradient(90deg, transparent 0 39px, #121212 39px 40px),
      #050505;
  }
  .rc-svg .buoy {
    fill: #ff8c1a;
    stroke: #000;
    stroke-width: 0.15;
  }
  .rc-svg .clear {
    fill: none;
    stroke: #ff8c1a;
    stroke-opacity: 0.25;
    stroke-dasharray: 0.4 0.4;
  }
  .rc-svg .lane {
    stroke: #262626;
    stroke-dasharray: 1 1;
  }
  .rc-svg .seg {
    stroke-linecap: round;
    fill: none;
  }
  .rc-svg .boat {
    fill: #fff;
    filter: drop-shadow(0 0 2px var(--tone));
  }
  .rc-svg .wake {
    fill: none;
    stroke: #fff;
    stroke-opacity: 0.5;
    stroke-linecap: round;
  }
  @container panel (max-width: 540px) {
    .rc-svg {
      height: 240px;
    }
  }
  .rc-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 12px;
    font: 12px var(--mono);
    color: #6a6a6a;
  }
  .rc-key i {
    display: inline-block;
    width: 22px;
    height: 3px;
    margin: 0 4px 2px;
    vertical-align: middle;
    background: #3a3a3a;
  }
  .rc-key i.f {
    background: var(--tone);
  }
</style>

<script>
  import data from "../../data/jaguar.json";

  const NS = "http://www.w3.org/2000/svg";
  const SPEEDUP = 10;

  class RaceCourse extends HTMLElement {
    connectedCallback() {
      this.svg = this.querySelector("svg");
      this.k = Object.fromEntries([...this.querySelectorAll("[data-k]")].map((e) => [e.dataset.k, e]));
      this.tone = getComputedStyle(this).getPropertyValue("--tone").trim() || "#55aaff";
      this.querySelectorAll(".p-seg button").forEach((b) =>
        b.addEventListener("click", () => {
          this.querySelectorAll(".p-seg button").forEach((o) => o.setAttribute("aria-pressed", o === b));
          this.load(+b.dataset.i);
        }),
      );
      new IntersectionObserver(([e]) => {
        this.visible = e.isIntersecting;
        if (this.visible) this.loop();
      }).observe(this);
      this.load(0);
    }

    load(i) {
      const e = (this.ev = data.race.events[i]);
      // view box around the path and marks, y flipped so +y is up
      const xs = [...e.path.map((p) => p[0]), ...e.marks.map((m) => m[0])];
      const ys = [...e.path.map((p) => -p[1]), ...e.marks.map((m) => -m[1])];
      const pad = 6;
      let [x0, x1, y0, y1] = [Math.min(...xs) - pad, Math.max(...xs) + pad, Math.min(...ys) - pad, Math.max(...ys) + pad];
      // keep the box at least as wide as the svg, so short courses don't blow up
      const ar = this.svg.clientWidth / this.svg.clientHeight || 3;
      if ((x1 - x0) / (y1 - y0) < ar) {
        const w = (y1 - y0) * ar,
          c = (x0 + x1) / 2;
        [x0, x1] = [c - w / 2, c + w / 2];
      } else {
        const h = (x1 - x0) / ar,
          c = (y0 + y1) / 2;
        [y0, y1] = [c - h / 2, c + h / 2];
      }
      this.svg.setAttribute("viewBox", `${x0} ${y0} ${x1 - x0} ${y1 - y0}`);
      const u = (x1 - x0) / 300; // one "pixel-ish" unit
      this.u = u;

      // cumulative distance along the path, to place the boat by distance
      this.cum = [0];
      for (let j = 1; j < e.path.length; j++) {
        const [a, b] = [e.path[j - 1], e.path[j]];
        this.cum.push(this.cum[j - 1] + Math.hypot(b[0] - a[0], b[1] - a[1]));
      }
      const scale = e.dist / this.cum.at(-1);
      this.cum = this.cum.map((c) => c * scale);

      const vmin = Math.min(...e.speed.slice(5).map((s) => s[1])),
        vmax = e.top;
      const rgb = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
      const [lo, hi] = [rgb("#3a3a3a"), rgb(/^#[0-9a-f]{6}$/i.test(this.tone) ? this.tone : "#55aaff")];
      const col = (v) => {
        const t = Math.max(0, Math.min(1, (v - vmin) / (vmax - vmin)));
        return `rgb(${lo.map((c, i) => Math.round(c + (hi[i] - c) * t)).join(",")})`;
      };

      let s = `<line class="lane" x1="${x0}" x2="${x1}" y1="0" y2="0" stroke-width="${u * 0.6}"/>`;
      for (let j = 1; j < e.path.length; j++) {
        const [a, b] = [e.path[j - 1], e.path[j]];
        s += `<line class="seg" x1="${a[0]}" y1="${-a[1]}" x2="${b[0]}" y2="${-b[1]}" stroke="${col(this.speedAt(this.cum[j]))}" stroke-width="${u * 2.2}"/>`;
      }
      for (const [x, y] of e.marks) s += `<circle class="clear" cx="${x}" cy="${-y}" r="0.6" stroke-width="${u * 0.5}"/><circle class="buoy" cx="${x}" cy="${-y}" r="${u * 2.4}"/>`;
      s += `<path class="wake" stroke-width="${u * 1.2}"/><circle class="boat" r="${u * 3}"/>`;
      this.svg.innerHTML = s;
      this.boat = this.svg.querySelector(".boat");
      this.wake = this.svg.querySelector(".wake");
      this.k.info.textContent = `${e.name} · ${e.crew} lb crew · ${e.time} s · ${e.straight_s} s straight, ${e.turn_s} s turning`;
      this.t0 = performance.now();
    }

    // speed table rows: [distance m, speed m/s, time s]
    speedAt(d) {
      const S = this.ev.speed;
      let j = S.findIndex((r) => r[0] >= d);
      if (j <= 0) return S[Math.max(0, j)][1];
      const [a, b] = [S[j - 1], S[j]];
      return a[1] + ((b[1] - a[1]) * (d - a[0])) / (b[0] - a[0] || 1);
    }
    distAt(t) {
      const S = this.ev.speed;
      let j = S.findIndex((r) => r[2] >= t);
      if (j < 0) return this.ev.dist;
      if (j === 0) return 0;
      const [a, b] = [S[j - 1], S[j]];
      return a[0] + ((b[0] - a[0]) * (t - a[2])) / (b[2] - a[2] || 1);
    }
    pointAt(d) {
      const c = this.cum,
        P = this.ev.path;
      let j = c.findIndex((v) => v >= d);
      if (j <= 0) return j === 0 ? P[0] : P.at(-1);
      const f = (d - c[j - 1]) / (c[j] - c[j - 1] || 1);
      return [P[j - 1][0] + (P[j][0] - P[j - 1][0]) * f, P[j - 1][1] + (P[j][1] - P[j - 1][1]) * f];
    }

    loop() {
      if (this.raf) return;
      const step = () => {
        this.raf = null;
        if (!this.visible) return;
        const e = this.ev;
        let t = ((performance.now() - this.t0) / 1000) * SPEEDUP;
        if (t > e.time + 15) (this.t0 = performance.now()), (t = 0);
        const tt = Math.min(t, e.time);
        const d = this.distAt(tt);
        const [x, y] = this.pointAt(d);
        this.boat.setAttribute("cx", x);
        this.boat.setAttribute("cy", -y);
        const tail = [];
        for (let k = 0; k <= 8; k++) tail.push(this.pointAt(Math.max(0, d - k * 0.9)));
        this.wake.setAttribute("d", "M" + tail.map(([a, b]) => `${a} ${-b}`).join(" L"));
        this.k.t.textContent = tt.toFixed(1);
        this.k.v.textContent = (t >= e.time ? 0 : this.speedAt(d)).toFixed(2);
        this.raf = requestAnimationFrame(step);
      };
      this.raf = requestAnimationFrame(step);
    }
  }
  customElements.define("race-course", RaceCourse);
</script>
