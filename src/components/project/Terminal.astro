---
// a captured terminal session. `text` is the raw output; lines starting with "$ " are commands.
// lines matching `hi` are brightened, `ok` go green, `gov` take the page's accent.
// long lines wrap instead of scrolling: the rest of the line hangs under its own indent, two columns in
const { title = "terminal", text, hi = [], ok = [], gov = [] } = Astro.props;
const test = (line, list) => list.some((p) => line.includes(p));
const lines = text.replace(/^\n|\n\s*$/g, "").split("\n");
const cls = (l) =>
  l.startsWith("$ ") ? "cmd" : test(l, gov) ? "gov" : test(l, ok) ? "ok" : test(l, hi) ? "hi" : "";
const hang = (l) => `--hang:${l.match(/^ */)[0].length + 2}ch`;
---

<div class="p-term">
  <div class="bar"><i></i><i></i><i></i><span>{title}</span></div>
  <pre>{
    lines.map((l) => (
      <div class={cls(l) || undefined} style={hang(l)}>{l.startsWith("$ ") ? l.slice(2) : l || " "}</div>
    ))
  }</pre>
</div>
