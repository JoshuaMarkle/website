---
// Milestone's core loop in miniature: start a live drive, watch the clock, end it, and the day or night
// goal fills. Time runs fast (one second here is five minutes of driving). Starting totals match the
// app's promo screenshots.
---

<mini-log class="ml">
  <div class="ml-phone">
    <div class="ml-top">
      <span class="ml-t">Total Drive Time</span>
      <span class="ml-total" data-k="total">32 Hours 55 Minutes</span>
    </div>
    <div class="ml-body">
      <p class="ml-h">Progress</p>
      <div class="ml-row" data-row="day">
        <span class="ml-ic">☀</span>
        <div class="ml-meta">
          <b>Day Hours</b>
          <span><span data-k="dayn">18</span> Logged Drives <em data-k="day">26h 40m / 40h</em></span>
          <span class="ml-bar"><i data-b="day"></i></span>
        </div>
      </div>
      <div class="ml-row" data-row="night">
        <span class="ml-ic">☾</span>
        <div class="ml-meta">
          <b>Night Hours</b>
          <span><span data-k="nightn">5</span> Logged Drives <em data-k="night">6h 15m / 10h</em></span>
          <span class="ml-bar"><i data-b="night"></i></span>
        </div>
      </div>
      <div class="ml-live" hidden>
        <span class="ml-dot"></span> Live drive <b data-k="clock">0:00</b>
      </div>
      <div class="ml-ctl">
        <div class="ml-switch" role="group" aria-label="Drive type">
          <button type="button" aria-pressed="true" data-m="day">Day</button>
          <button type="button" aria-pressed="false" data-m="night">Night</button>
        </div>
        <button type="button" class="ml-go">Start drive</button>
      </div>
    </div>
  </div>
  <p class="ml-note">Try it: start a drive, then end it. 1 s here = 5 min on the road.</p>
</mini-log>

<style is:global>
  mini-log {
    --tone: #55aaff; /* Milestone's own blue (lib/theme.dart), which the project pages share */
    display: block;
    margin: 2em 0 2.25em;
  }
  .ml-phone {
    max-width: 360px;
    margin: 0 auto;
    border: 8px solid #161616;
    border-radius: 34px;
    overflow: hidden;
    background: #fafafa;
    font-family: Roboto, system-ui, sans-serif;
    box-shadow: 0 30px 80px -30px color-mix(in srgb, var(--tone) 50%, transparent);
  }
  .ml-top {
    display: grid;
    gap: 4px;
    padding: 34px 20px 30px;
    background: var(--tone);
    border-radius: 0 0 22px 22px;
    text-align: center;
    color: #fff;
  }
  .ml-t {
    font-size: 15px;
    font-weight: 700;
  }
  .ml-total {
    font-size: 24px;
    font-variant-numeric: tabular-nums;
  }
  .ml-body {
    padding: 18px 20px 22px;
    color: #444;
  }
  .prose-post .ml-h {
    margin: 0 0 12px;
    font-size: 16px;
    font-weight: 700;
    color: #444;
  }
  .ml-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
    border-radius: 12px;
    transition: background 0.3s ease;
  }
  .ml-row.on {
    background: color-mix(in srgb, var(--tone) 8%, transparent);
  }
  .ml-ic {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--tone);
    font-size: 20px;
    color: #fff;
  }
  .ml-meta {
    display: grid;
    flex: 1;
    gap: 2px;
    font-size: 12px;
    color: #aaa;
  }
  .ml-meta b {
    font-size: 15px;
    font-weight: 500;
    color: #444;
  }
  .ml-meta em {
    float: right;
    font-style: normal;
    font-variant-numeric: tabular-nums;
  }
  .ml-bar {
    display: block;
    height: 4px;
    margin-top: 4px;
    background: #e8e8e8;
  }
  .ml-bar i {
    display: block;
    height: 100%;
    background: var(--tone);
    transition: width 0.25s linear;
  }
  .ml-live {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 4px 0 12px;
    font-size: 13px;
    color: #666;
  }
  .ml-live b {
    margin-left: auto;
    font-size: 20px;
    font-weight: 500;
    color: #333;
    font-variant-numeric: tabular-nums;
  }
  .ml-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f44;
    animation: ml-pulse 1s ease infinite;
  }
  @keyframes ml-pulse {
    50% {
      opacity: 0.3;
    }
  }
  .ml-ctl {
    display: flex;
    gap: 10px;
  }
  .ml-switch {
    display: flex;
    padding: 3px;
    border-radius: 22px;
    background: #ececec;
  }
  .ml-switch button {
    padding: 8px 12px;
    border: 0;
    border-radius: 18px;
    background: none;
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    color: #888;
    cursor: pointer;
  }
  .ml-switch button[aria-pressed="true"] {
    background: #fff;
    color: #333;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }
  .ml-switch button:disabled {
    cursor: default;
  }
  .ml-go {
    flex: 1;
    border: 0;
    border-radius: 22px;
    background: var(--tone);
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    cursor: pointer;
  }
  .ml-go.stop {
    background: #333;
  }
  .prose-post .ml-note {
    margin: 14px 0 0;
    font-size: 13px;
    text-align: center;
    color: #6a6a6a;
  }
</style>

<script>
  const GOAL = { day: 40 * 60, night: 10 * 60 }; // minutes
  const RATE = 5; // driving minutes per real second
  const fmt = (m) => `${Math.floor(m / 60)}h ${String(Math.round(m % 60)).padStart(2, "0")}m`;

  class MiniLog extends HTMLElement {
    connectedCallback() {
      this.mins = { day: 26 * 60 + 40, night: 6 * 60 + 15 };
      this.n = { day: 18, night: 5 };
      this.mode = "day";
      this.k = Object.fromEntries([...this.querySelectorAll("[data-k]")].map((e) => [e.dataset.k, e]));
      this.b = Object.fromEntries([...this.querySelectorAll("[data-b]")].map((e) => [e.dataset.b, e]));
      this.go = this.querySelector(".ml-go");
      this.modes = [...this.querySelectorAll(".ml-switch button")];
      this.modes.forEach((b) =>
        b.addEventListener("click", () => {
          this.mode = b.dataset.m;
          this.modes.forEach((o) => o.setAttribute("aria-pressed", o === b));
        }),
      );
      this.go.addEventListener("click", () => (this.t0 ? this.end() : this.start()));
      this.render(0);
    }
    start() {
      this.t0 = performance.now();
      this.go.textContent = "End drive";
      this.go.classList.add("stop");
      this.modes.forEach((b) => (b.disabled = true));
      this.querySelector(".ml-live").hidden = false;
      this.querySelector(`[data-row="${this.mode}"]`).classList.add("on");
      const tick = () => {
        if (!this.t0) return;
        this.render(this.live());
        requestAnimationFrame(tick);
      };
      tick();
    }
    live() {
      return ((performance.now() - this.t0) / 1000) * RATE;
    }
    end() {
      const m = this.live();
      this.t0 = 0;
      if (m >= 1) {
        this.mins[this.mode] += m;
        this.n[this.mode]++;
      }
      this.go.textContent = "Start drive";
      this.go.classList.remove("stop");
      this.modes.forEach((b) => (b.disabled = false));
      this.querySelector(".ml-live").hidden = true;
      this.querySelectorAll(".ml-row").forEach((r) => r.classList.remove("on"));
      this.render(0);
    }
    render(live) {
      const cur = { ...this.mins };
      cur[this.mode] += this.t0 ? live : 0;
      const tot = cur.day + cur.night;
      this.k.total.textContent = `${Math.floor(tot / 60)} Hours ${Math.floor(tot % 60)} Minutes`;
      for (const s of ["day", "night"]) {
        this.k[s].textContent = `${fmt(cur[s])} / ${GOAL[s] / 60}h`;
        this.k[s + "n"].textContent = this.n[s];
        this.b[s].style.width = `${Math.min(100, (cur[s] / GOAL[s]) * 100)}%`;
      }
      const lm = Math.floor(live);
      this.k.clock.textContent = `${Math.floor(lm / 60)}:${String(lm % 60).padStart(2, "0")}`;
    }
  }
  customElements.define("mini-log", MiniLog);
</script>
