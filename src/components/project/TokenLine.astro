---
// one source line taken apart the way AlgoType's tokenizer does it: Prism types, skipped indentation,
// the newline token, and each token's wlength (how far to the end of its word)
import challenge from "../../data/algotype-quicksort.json";
const { line = 5 } = Astro.props;
const tokens = challenge.tokens[line];
---

<div class="p-panel tl">
  <p class="kicker">line {line + 1}, as the tokenizer sees it</p>
  <div class="tl-row">
    {
      tokens.map((t) => (
        <div class:list={["tl-tok", t.type, { skip: t.skip }]}>
          <code>{t.type === "space" ? "␣".repeat(t.content.length) : t.content}</code>
          <span class="tl-type">{t.skip ? "skip" : t.type}</span>
          {t.wlength && <span class="tl-w">{t.wlength}</span>}
        </div>
      ))
    }
  </div>
  <p class="cap">
    Indentation is marked <code>skip</code> and never typed. The small number is <code>wlength</code>: how many tokens remain in
    the word, which lets the engine stop a run of wrong keys from spilling into the next word.
  </p>
</div>

<style>
  .tl-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 6px;
    padding-top: 6px;
  }
  .tl-tok {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 8px 9px 6px;
    border: 1px solid #222;
    border-radius: 5px;
    background: #050505;
  }
  .tl-tok code {
    padding: 0 !important;
    background: none !important;
    font-size: 14px !important;
    white-space: pre;
    color: #e8e8e8 !important;
  }
  .tl-type {
    font: 10px var(--mono);
    letter-spacing: 0.04em;
    color: #6a6a6a;
  }
  .tl-w {
    position: absolute;
    top: -8px;
    right: -6px;
    min-width: 15px;
    padding: 0 3px;
    border: 1px solid #333;
    border-radius: 8px;
    background: #141414;
    font: 500 10px/14px var(--mono);
    text-align: center;
    color: #e8e8e8;
  }
  /* skipped indentation: the same tint as the typed spaces, only its border is dashed */
  .tl-tok.skip {
    border-style: dashed;
    border-color: #2e2e2e;
  }
  .tl-tok.skip code {
    color: #5a5a5a !important;
  }
  /* same colors as the typing test above */
  .keyword code {
    color: #7cc4ff !important;
  }
  .function code {
    color: #c3b5ff !important;
  }
  .builtin code {
    color: #8fd6c7 !important;
  }
  .punctuation code {
    color: #a8a8a8 !important;
  }
  .operator code {
    color: #9fd0ff !important;
  }
  :is(.number, .boolean) code {
    color: #f2c47c !important;
  }
  .newline code {
    color: #6a6a6a !important;
  }
  .space code {
    color: #5a5a5a !important;
  }
</style>
